#!/usr/bin/env python3
"""scripts/dev — run, wait for and report on long jobs and the pre-publication gate.

Decision and rationale: docs/adr/0126-dev-job-runner-for-long-jobs-and-gates.md

    scripts/dev run <name> -- <command...>   start a detached job, print its id
    scripts/dev gate [--only a,b] [--fresh]  run `cargo fmt --all`, then branch/checks/lint/test/
        [--quick|--full] [--focus PATH...]   roast as one job (the formatter is applied, never
                                             checked); the quick profile (default in a remote
                                             container) builds debug only: branch, checks,
                                             default clippy, cargo test, and the t/ and
                                             roast files the change touches or --focus names
    scripts/dev wait <id> [--max SECONDS]    block until done, at most --max (540)
    scripts/dev status [<id>]                running / passed / failed / lost
    scripts/dev report <id>                  the gate's report.json
    scripts/dev log <id> [--tail N]          the job's output
    scripts/dev stop <id>                    SIGTERM the job's process group
    scripts/dev branch-check                 list files changed vs the merge base with
                                             origin/main; fail if one is back at an older
                                             main state (a stale tree on a newer main)
    scripts/dev self-test                    exercise the pieces above

A job is the directory tmp/jobs/<id>/ -- meta.json, log, exit, and for a gate
report.json. Its state is read from those files and from the recorded pid,
never by matching process command lines (`pgrep -f` finds its own shell).

`wait` exit status: 0 passed, 1 failed, 70 lost (died without reporting),
75 still running when --max ran out (wait again), 2 usage error.
"""

from __future__ import annotations

import argparse
import contextlib
import io
import datetime as dt
import errno
import fcntl
import json
import os
import random
import re
import shutil
import signal
import string
import subprocess
import sys
import tempfile
import time
import tomllib

EXIT_PASSED = 0
EXIT_FAILED = 1
EXIT_USAGE = 2
EXIT_LOST = 70
EXIT_RUNNING = 75

DEFAULT_WAIT_MAX = 540
GATE_STAGES = ("branch", "checks", "lint", "test", "roast")
STAGE_COMMANDS = {
    "branch": ["scripts/dev", "branch-check"],
    "checks": ["make", "-k", "checks"],
    "lint": ["make", "lint"],
    "test": ["make", "test"],
    "roast": ["make", "roast"],
}
# Formatting is not a stage. `gate` applies the formatter to the working tree
# before it takes the tree id (see `format_tree`), so the verdict describes the
# formatted tree and a mis-formatted file costs a second of `rustfmt`, not a
# failed gate and a rerun. CI's `cargo fmt --check` then always sees what the
# gate saw, provided the formatter's changes are committed.
FORMAT_COMMAND = ["cargo", "fmt", "--all"]
# Stages whose failure makes the later ones pointless: a tree that fails a
# static guard (`make checks`: t/ layout, ratchets, self-tests -- seconds, no
# build), or does not lint, is not going to be published, and running an hour of suites
# on it only delays the answer. `test` and `roast` both run regardless, so one
# gate shows every red file.
BLOCKING_STAGES = ("branch", "checks", "lint", "clippy")

# The quick profile, for the ~4-core remote container (ADR-0126, amendment 2026-10-02). The
# full gate compiles the crate about seven times (four lint configurations,
# rustdoc, release, debug tests) and runs the whole TAP and roast suites on
# the release binary; on that box it takes longer than the CI run that repeats
# it. The quick profile compiles twice -- the default clippy pass and the
# debug test build -- and runs only the t/ and roast files the change touches
# (or `--focus` names) on the debug binary that `cargo test` already left
# behind. CI's full matrix stays the net for the rest.
QUICK_STAGES = ("branch", "checks", "clippy", "cargo-test", "t-focus", "roast-focus")
STAGE_COMMANDS.update({
    "clippy": ["cargo", "clippy", "--workspace", "--all-targets", "--", "-D", "warnings"],
    "cargo-test": ["bash", "-o", "pipefail", "-c",
                   "RUST_MIN_STACK=8388608 cargo test -- --test-threads=1"
                   " && RUST_MIN_STACK=8388608 cargo test -p mutsu-lsp"],
})
# A debug binary is about 3.3x slower than release; the suites' per-file
# timeouts are sized for release.
DEBUG_TIMEOUT_SCALE = 4


def repo_root() -> str:
    out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True,
                         text=True, check=True)
    return out.stdout.strip()


def jobs_dir(root: str) -> str:
    return os.path.join(root, "tmp", "jobs")


def job_path(root: str, job_id: str) -> str:
    return os.path.join(jobs_dir(root), job_id)


def write_atomic(path: str, text: str) -> None:
    tmp = f"{path}.tmp{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)


def read_json(path: str):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


# --- process identity -------------------------------------------------------

def proc_start_time(pid: int) -> str | None:
    """The kernel's start time of `pid` (clock ticks since boot), or None.

    Recorded next to the pid so a later check cannot be fooled by pid reuse:
    a recycled pid has a different start time."""
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8") as fh:
            stat = fh.read()
    except OSError:
        return None
    # Field 2 (comm) is parenthesized and may contain spaces; split after it.
    rest = stat[stat.rfind(")") + 2:].split()
    return rest[19] if len(rest) > 19 else None


def pid_alive(pid: int, start: str | None) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    if start is None:
        return True
    now = proc_start_time(pid)
    return now is None or now == start


# --- tree identity ------------------------------------------------------------

def tree_id(root: str) -> str:
    """`git write-tree` of the working tree (tracked and untracked, minus
    .gitignore'd files), computed on a scratch copy of the index so the
    user's own staging area is untouched."""
    index = subprocess.run(["git", "rev-parse", "--git-path", "index"], cwd=root,
                           capture_output=True, text=True, check=True).stdout.strip()
    index = os.path.join(root, index) if not os.path.isabs(index) else index
    with tempfile.TemporaryDirectory() as tmpd:
        scratch = os.path.join(tmpd, "index")
        if os.path.exists(index):
            shutil.copyfile(index, scratch)
        env = dict(os.environ, GIT_INDEX_FILE=scratch)
        subprocess.run(["git", "add", "-A"], cwd=root, env=env, check=True,
                       capture_output=True)
        out = subprocess.run(["git", "write-tree"], cwd=root, env=env, check=True,
                             capture_output=True, text=True)
        return out.stdout.strip()


def format_tree(root: str, command: list[str] | None = None) -> tuple[str, list[str]]:
    """Apply the formatter to the working tree and return `(tree id, files it
    changed)`.

    The files are read off the tree ids before and after (`git diff-tree` on
    the two trees `tree_id` wrote), so no second `--check` pass is needed and an
    unrelated dirty file is not mistaken for a formatting change. Raises
    `RuntimeError` with rustfmt's own message when it cannot format -- a file
    that does not parse, rustfmt missing -- because the tree then cannot pass
    any later stage either."""
    before = tree_id(root)
    run = subprocess.run(command or FORMAT_COMMAND, cwd=root, capture_output=True, text=True)
    if run.returncode != 0:
        raise RuntimeError((run.stderr or run.stdout).strip() or f"exit {run.returncode}")
    after = tree_id(root)
    if after == before:
        return after, []
    changed = git_lines(root, "diff-tree", "-r", "--name-only", "--no-commit-id", before, after)
    return after, sorted(changed or [])


def head_commit(root: str) -> str:
    out = subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=root,
                         capture_output=True, text=True)
    return out.stdout.strip()


# --- job state ------------------------------------------------------------------

def job_state(root: str, job_id: str) -> dict:
    """{'state': running|passed|failed|lost|missing, 'meta': ..., 'exit': int|None}"""
    path = job_path(root, job_id)
    meta = read_json(os.path.join(path, "meta.json"))
    if meta is None:
        return {"state": "missing", "meta": None, "exit": None}
    try:
        with open(os.path.join(path, "exit"), encoding="utf-8") as fh:
            code = int(fh.read().strip())
    except (OSError, ValueError):
        code = None
    if code is not None:
        return {"state": "passed" if code == 0 else "failed", "meta": meta, "exit": code}
    pid = meta.get("pid")
    if pid and pid_alive(pid, meta.get("pid_start")):
        return {"state": "running", "meta": meta, "exit": None}
    # `run` writes meta.json before the supervisor fills in its pid; a job
    # younger than a few seconds with no pid yet is still starting.
    if pid is None and time.time() - meta.get("started_epoch", 0) < 10:
        return {"state": "running", "meta": meta, "exit": None}
    return {"state": "lost", "meta": meta, "exit": None}


def list_jobs(root: str) -> list[str]:
    try:
        names = os.listdir(jobs_dir(root))
    except FileNotFoundError:
        return []
    return sorted(n for n in names if n != "lock" and
                  os.path.isfile(os.path.join(jobs_dir(root), n, "meta.json")))


def new_job_id(name: str) -> str:
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    salt = "".join(random.choices(string.ascii_lowercase + string.digits, k=4))
    return f"{name}-{stamp}-{salt}"


def acquire_lock(root: str, name: str):
    """Take the per-name lock without blocking. Returns the open fd, or None
    if another job of this name holds it."""
    lock_dir = os.path.join(jobs_dir(root), "lock")
    os.makedirs(lock_dir, exist_ok=True)
    fd = os.open(os.path.join(lock_dir, name), os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as err:
        os.close(fd)
        if err.errno in (errno.EAGAIN, errno.EACCES):
            return None
        raise
    return fd


def running_job_named(root: str, name: str) -> str | None:
    for job_id in reversed(list_jobs(root)):
        st = job_state(root, job_id)
        if st["meta"] and st["meta"].get("name") == name and st["state"] == "running":
            return job_id
    return None


def start_job(root: str, name: str, spec: dict) -> str:
    """Create the job directory and hand it to a detached supervisor, which
    inherits the per-name lock and holds it for the job's whole life."""
    fd = acquire_lock(root, name)
    if fd is None:
        other = running_job_named(root, name)
        raise SystemExit(f"dev: a '{name}' job is already running"
                         + (f": {other}" if other else "") + "; wait for it or stop it")
    job_id = new_job_id(name)
    path = job_path(root, job_id)
    os.makedirs(path)
    meta = dict(spec, id=job_id, name=name, started=dt.datetime.now().isoformat(timespec="seconds"),
                started_epoch=time.time(), pid=None, pid_start=None, host=os.uname().nodename)
    write_atomic(os.path.join(path, "meta.json"), json.dumps(meta, indent=2) + "\n")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "_supervise", job_id],
                     cwd=root, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True, pass_fds=(fd,))
    os.close(fd)
    return job_id


# --- supervisor -------------------------------------------------------------------

class Stopped(Exception):
    pass


def supervise(root: str, job_id: str) -> None:
    path = job_path(root, job_id)
    meta_path = os.path.join(path, "meta.json")
    meta = read_json(meta_path)
    meta["pid"] = os.getpid()
    meta["pid_start"] = proc_start_time(os.getpid())
    meta["pgid"] = os.getpgid(0)
    write_atomic(meta_path, json.dumps(meta, indent=2) + "\n")

    stopped = {"flag": False}

    def on_term(signum, _frame):
        stopped["flag"] = True

    signal.signal(signal.SIGTERM, on_term)
    log = open(os.path.join(path, "log"), "a", encoding="utf-8", errors="replace")
    try:
        if meta.get("kind") == "gate":
            code = run_gate(root, path, meta, log, stopped)
        else:
            code = run_command(meta["argv"], root, log, stopped)
    except Exception as exc:  # the job must still report, whatever went wrong
        log.write(f"\ndev: supervisor error: {exc!r}\n")
        code = 1
    if stopped["flag"]:
        log.write("\ndev: stopped\n")
        code = 143
    log.close()
    write_atomic(os.path.join(path, "exit"), f"{code}\n")


def run_command(argv: list[str], cwd: str, log, stopped, env=None) -> int:
    log.write(f"$ {' '.join(argv)}\n")
    log.flush()
    # The child shares the supervisor's process group, so `dev stop`'s
    # `killpg` reaches it (and everything it spawned) directly; the
    # supervisor's own SIGTERM handler only records that it was stopped.
    proc = subprocess.Popen(argv, cwd=cwd, stdin=subprocess.DEVNULL, stdout=log,
                            stderr=subprocess.STDOUT, env=env)
    return proc.wait()


# --- the gate ---------------------------------------------------------------------

def run_gate(root: str, path: str, meta: dict, log, stopped) -> int:
    known = load_known_failures(root)
    conditions = host_conditions()
    report = {"tree": meta["tree"], "commit": meta.get("commit"), "host": meta["host"],
              "profile": meta.get("profile", "full"), "focus": meta.get("focus"),
              "conditions": sorted(conditions), "stages": {}, "verdict": "running"}
    report_path = os.path.join(path, "report.json")
    blocked = False
    for stage in meta["stages"]:
        if blocked or stopped["flag"]:
            report["stages"][stage] = {"status": "skipped"}
            continue
        stage_log_path = os.path.join(path, f"stage-{stage}.log")
        with open(stage_log_path, "w", encoding="utf-8", errors="replace") as stage_log:
            started = time.time()
            command = meta.get("commands", {}).get(stage) or STAGE_COMMANDS[stage]
            code = run_command(command, root, stage_log, stopped)
        with open(stage_log_path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
        log.write(f"== {stage}: exit {code} ({time.time() - started:.0f}s)\n")
        log.flush()
        if stopped["flag"]:
            result = {"status": "stopped"}
        else:
            result = judge_stage(stage, code, text, known, conditions)
        result["seconds"] = round(time.time() - started)
        report["stages"][stage] = result
        write_atomic(report_path, json.dumps(report, indent=2) + "\n")
        if result["status"] != "pass" and stage in BLOCKING_STAGES:
            blocked = True
    if stopped["flag"]:
        report["verdict"] = "stopped"
    else:
        report["verdict"] = ("pass" if all(s["status"] == "pass"
                                           for s in report["stages"].values()) else "fail")
    write_atomic(report_path, json.dumps(report, indent=2) + "\n")
    return 0 if report["verdict"] == "pass" else 1


def judge_stage(stage: str, code: int, text: str, known: list, conditions: set) -> dict:
    if stage in BLOCKING_STAGES:
        return {"status": "pass" if code == 0 else "fail"}
    failures = parse_prove_summary(text)
    known_env, unexpected = [], []
    for f in failures:
        if matches_known(f, known, conditions):
            known_env.append(f["file"])
        else:
            unexpected.append(describe_failure(f))
    if code != 0 and not failures:
        # The suite died before (or outside) prove: a build error, a cargo
        # unit test, a check-* guard. There is no per-file verdict to classify,
        # but a failing cargo test names itself; report those names.
        cargo = cargo_test_failures(text)
        if cargo:
            unexpected.extend(cargo)
        else:
            unexpected.append(f"stage `{stage}` exited {code} without a TAP failure summary; "
                              f"see stage-{stage}.log")
    files = parse_prove_file_count(text)
    result = {"status": "pass" if not unexpected else "fail", "known_env": known_env,
              "unexpected": unexpected}
    if files is not None:
        result["files"] = files
    return result


SUMMARY_FILE_RE = re.compile(
    r"^(?P<file>\S+\.t)\s+\(Wstat: (?P<wstat>\d+)(?: \((?:exited (?P<exited>\d+)|[^)]*)\))?"
    r" Tests: (?P<tests>\d+) Failed: (?P<failed>\d+)\)")
PLAN_RE = re.compile(r"You planned (\d+) tests? but ran (\d+)")


def parse_prove_summary(text: str) -> list[dict]:
    """Every *failing* file in prove's "Test Summary Report". A file listed
    only for "TODO passed" is not a failure and is skipped."""
    start = text.rfind("Test Summary Report")
    if start < 0:
        return []
    failures, cur, field = [], None, None
    for line in text[start:].splitlines():
        m = SUMMARY_FILE_RE.match(line)
        if m:
            cur = {"file": m["file"], "wstat": int(m["wstat"]),
                   "exit": int(m["exited"]) if m["exited"] else (0 if m["wstat"] == "0" else None),
                   "ran": int(m["tests"]), "failed": [], "planned": None, "parse_errors": False}
            failures.append(cur)
            field = None
            continue
        if cur is None:
            continue
        stripped = line.strip()
        if stripped.startswith("Failed tests:") or stripped.startswith("Failed test:"):
            field = "failed"
            cur["failed"].extend(expand_ranges(stripped.split(":", 1)[1]))
        elif field == "failed" and line.startswith(" ") and re.fullmatch(r"[\d,\s-]+", stripped):
            cur["failed"].extend(expand_ranges(stripped))
        elif stripped.startswith("Parse errors:"):
            field = None
            cur["parse_errors"] = True
            pm = PLAN_RE.search(stripped)
            if pm:
                cur["planned"] = int(pm[1])
        else:
            field = None
    return [f for f in failures if f["failed"] or f["wstat"] != 0 or f["parse_errors"]]


def cargo_test_failures(text: str) -> list[str]:
    """`cargo test` failures named in its output: each failed `#[test]`, and
    each test binary that aborted (a stack overflow names no test)."""
    out = [f"cargo test: {m}" for m in re.findall(r"^test (\S+) \.\.\. FAILED$", text, re.M)]
    for target in re.findall(r"to rerun pass `([^`]+)`", text):
        overflow = re.search(r"^thread '([^']+)' \(\d+\) has overflowed its stack", text, re.M)
        if overflow and not out:
            out.append(f"cargo test {target}: {overflow[1]} overflowed its stack")
        elif not out:
            out.append(f"cargo test {target}: failed")
    return out


def parse_prove_file_count(text: str) -> int | None:
    m = re.findall(r"^Files=(\d+), Tests=", text, re.M)
    return int(m[-1]) if m else None


def expand_ranges(spec: str) -> list[int]:
    out: list[int] = []
    for part in re.split(r"[,\s]+", spec.strip()):
        if not part:
            continue
        if "-" in part:
            lo, hi = part.split("-", 1)
            out.extend(range(int(lo), int(hi) + 1))
        else:
            out.append(int(part))
    return out


def describe_failure(f: dict) -> str:
    bits = []
    if f["failed"]:
        bits.append(f"failed {compress_ranges(f['failed'])}")
    if f["exit"]:
        bits.append(f"exit {f['exit']}")
    if f["planned"] is not None:
        bits.append(f"planned {f['planned']} ran {f['ran']}")
    return f"{f['file']}: " + (", ".join(bits) or f"wstat {f['wstat']}")


def compress_ranges(nums: list[int]) -> str:
    nums = sorted(set(nums))
    out, i = [], 0
    while i < len(nums):
        j = i
        while j + 1 < len(nums) and nums[j + 1] == nums[j] + 1:
            j += 1
        out.append(str(nums[i]) if i == j else f"{nums[i]}-{nums[j]}")
        i = j + 1
    return ", ".join(out)


# --- known environment failures ---------------------------------------------------

def load_known_failures(root: str) -> list[dict]:
    path = os.path.join(root, "ci", "known-env-failures.toml")
    try:
        with open(path, "rb") as fh:
            return tomllib.load(fh).get("failure", [])
    except FileNotFoundError:
        return []


def host_conditions() -> set[str]:
    """The environment conditions a known failure can be conditional on."""
    found = set()
    if os.getuid() == 0:
        found.add("uid0")
    try:
        with open("/proc/1/environ", "rb") as fh:
            fh.read(1)
    except OSError:
        found.add("restricted-proc")
    # The remote agent container routes all outbound traffic through the agent
    # proxy and cannot resolve or reach arbitrary hosts.
    if os.environ.get("CCR_AGENT_PROXY_ENABLED"):
        found.add("sandboxed-network")
    return found


def matches_known(f: dict, known: list, conditions: set) -> bool:
    for entry in known:
        if entry.get("file") != f["file"]:
            continue
        needs = entry.get("when", [])
        needs = [needs] if isinstance(needs, str) else needs
        if not all(c in conditions for c in needs):
            continue
        shape = entry.get("shape", {})
        if sorted(set(expand_ranges(shape.get("failed", "")))) != sorted(set(f["failed"])):
            continue
        if "exit" in shape and shape["exit"] != f["exit"]:
            continue
        if "planned" in shape and shape["planned"] != f["planned"]:
            continue
        if "ran" in shape and shape["ran"] != f["ran"]:
            continue
        return True
    return False


# --- commands ---------------------------------------------------------------------

def cmd_run(root: str, args) -> int:
    argv = args.command
    if argv and argv[0] == "--":
        argv = argv[1:]
    if not argv:
        print("dev run: no command given (use: dev run <name> -- <command...>)", file=sys.stderr)
        return EXIT_USAGE
    job_id = start_job(root, args.name, {"kind": "command", "argv": argv,
                                         "tree": tree_id(root), "commit": head_commit(root)})
    print(job_id)
    return 0


def is_remote_container() -> bool:
    """The ephemeral Claude Code remote container (docs/agent-environments.md)."""
    return os.environ.get("CLAUDE_CODE_REMOTE") == "true"


def git_lines(root: str, *argv: str) -> list[str] | None:
    out = subprocess.run(["git", *argv], cwd=root, capture_output=True, text=True)
    return out.stdout.splitlines() if out.returncode == 0 else None


# Source areas whose change reaches far past the tests that name them: a built-in
# method's implementation is called by every `.gist`, `.raku`, `.WHICH` and
# `.Str` the suites make. ADR-11276's rows regressed `t/oo/nested-instance-raku.t`
# and `t/types/buf-and-list-mutators.t` twice -- tests the branch did not touch,
# outside a narrow `--focus`, which only CI caught. A change under these prefixes
# adds the directories to the focus on its own.
WIDE_FOCUS_SOURCES = (
    "src/builtins/method_table/",
    "src/builtins/methods_0arg/",
    "src/builtins/methods_narg/",
    "src/builtins/native_method_row_table.rs",
)
WIDE_FOCUS_DIRS = ("t/oo", "t/types", "t/collections")


def wide_focus(changed: list[str]) -> list[str]:
    """The directories a change to a built-in method's implementation adds to the
    focus: [] unless one of `changed` is under a WIDE_FOCUS_SOURCES prefix."""
    if any(path.startswith(WIDE_FOCUS_SOURCES) for path in changed):
        return list(WIDE_FOCUS_DIRS)
    return []


def focus_files(root: str, extra: list[str]) -> tuple[list[str], list[str]]:
    """The t/ and roast files a quick gate runs: every `.t` under t/ or roast/
    that differs from the merge base with origin/main (committed, staged,
    unstaged or untracked), every file added to roast-whitelist.txt, every
    `--focus` path (a file, or a directory searched for `.t` files), and the
    directories `wide_focus` adds for a change to a built-in method."""
    # A remote container's clone can carry an origin/main far behind the
    # branch, whose merge base would put every file main changed since in
    # focus; refresh it first (best effort -- offline, the stale ref stands).
    try:
        subprocess.run(["git", "fetch", "--quiet", "origin", "main"], cwd=root,
                       capture_output=True, timeout=60)
    except subprocess.TimeoutExpired:
        pass
    base = None
    for ref in ("origin/main", "main"):
        lines = git_lines(root, "merge-base", "HEAD", ref)
        if lines:
            base = lines[0]
            break
    paths: list[str] = []
    if base:
        paths += git_lines(root, "diff", "--name-only", "--diff-filter=AMR", base) or []
        for line in git_lines(root, "diff", "--unified=0", base, "--",
                              "roast-whitelist.txt") or []:
            if line.startswith("+") and not line.startswith("+++"):
                paths.append(line[1:].strip())
    paths += git_lines(root, "ls-files", "--others", "--exclude-standard", "t") or []
    extra = list(extra) + wide_focus(paths)
    for item in extra:
        full = os.path.join(root, item)
        if os.path.isdir(full):
            for dirpath, _dirs, files in os.walk(full):
                paths += [os.path.relpath(os.path.join(dirpath, f), root)
                          for f in files if f.endswith(".t")]
        else:
            paths.append(os.path.normpath(item))
    t_files, roast_files = set(), set()
    for path in paths:
        if not path.endswith(".t") or not os.path.isfile(os.path.join(root, path)):
            continue
        if path.startswith("t/"):
            t_files.add(path)
        elif path.startswith("roast/"):
            roast_files.add(path)
    return sorted(t_files), sorted(roast_files)


def focus_commands(t_files: list[str], roast_files: list[str]) -> dict:
    """prove over the debug binary; an empty selection is a no-op that passes."""
    jobs = str(max(1, min(4, os.cpu_count() or 1)))
    commands = {}
    for stage, files, runner, env in (
            ("t-focus", t_files, "scripts/run-t-test.sh",
             [f"MUTSU_T_TIMEOUT={30 * DEBUG_TIMEOUT_SCALE}"]),
            ("roast-focus", roast_files, "scripts/run-roast-test.sh",
             [f"MUTSU_ROAST_TIMEOUT_SCALE={DEBUG_TIMEOUT_SCALE}"])):
        commands[stage] = (["env", "MUTSU_BIN=target/debug/mutsu", *env, "prove", "-j", jobs,
                            "-e", runner, *files] if files else ["true"])
    return commands


def cmd_gate(root: str, args) -> int:
    quick = args.quick or (is_remote_container() and not args.full)
    profile = QUICK_STAGES if quick else GATE_STAGES
    stages = [s for s in profile if not args.only or s in args.only.split(",")]
    unknown = set(args.only.split(",")) - set(profile) if args.only else set()
    if unknown:
        print(f"dev gate: unknown stage(s) for the {'quick' if quick else 'full'} profile: "
              f"{', '.join(sorted(unknown))}", file=sys.stderr)
        return EXIT_USAGE
    if args.focus and not quick:
        print("dev gate: --focus applies to the quick profile only", file=sys.stderr)
        return EXIT_USAGE
    # Format first, before the tree id is taken: the verdict then describes the
    # formatted tree, and there is no `--check` stage that could fail on it.
    try:
        tree, formatted = format_tree(root)
    except RuntimeError as err:
        print(f"dev gate: `{' '.join(FORMAT_COMMAND)}` failed, so no later stage could pass "
              f"either:\n{err}", file=sys.stderr)
        return EXIT_FAILED
    if formatted:
        shown = ", ".join(formatted[:8]) + (f", ... ({len(formatted)} in all)"
                                            if len(formatted) > 8 else "")
        print(f"dev gate: `{' '.join(FORMAT_COMMAND)}` reformatted {len(formatted)} file(s): "
              f"{shown}\ndev gate: commit them -- the gate verifies the working tree, and CI "
              f"checks the pushed commit", file=sys.stderr)
    meta = {"kind": "gate", "profile": "quick" if quick else "full", "stages": stages}
    if quick:
        t_files, roast_files = focus_files(root, args.focus or [])
        meta["focus"] = {"t": t_files, "roast": roast_files}
        meta["commands"] = focus_commands(t_files, roast_files)
        print(f"dev gate: quick profile (debug build; {len(t_files)} t/ and "
              f"{len(roast_files)} roast file(s) in focus; --full for the whole gate)",
              file=sys.stderr)
    if not args.fresh:
        for job_id in reversed(list_jobs(root)):
            st = job_state(root, job_id)
            old = st["meta"]
            if (old and old.get("kind") == "gate" and old.get("tree") == tree
                    and old.get("stages") == stages and old.get("focus") == meta.get("focus")
                    and st["state"] in ("running", "passed", "failed")):
                print(job_id)
                print(f"dev gate: reusing {st['state']} gate {job_id} for tree {tree[:12]} "
                      f"(--fresh to run again)", file=sys.stderr)
                return 0
    job_id = start_job(root, "gate", {**meta, "tree": tree, "commit": head_commit(root)})
    print(job_id)
    return 0


def summarize(root: str, job_id: str) -> str:
    st = job_state(root, job_id)
    if st["state"] == "missing":
        return f"{job_id}: no such job"
    meta = st["meta"]
    head = f"{job_id}: {st['state']}"
    if st["exit"] is not None:
        head += f" (exit {st['exit']})"
    elif st["state"] == "running":
        head += f" ({elapsed(meta)})"
    lines = [head]
    report = read_json(os.path.join(job_path(root, job_id), "report.json"))
    if report:
        lines.append(f"  verdict: {report['verdict']}  profile {report.get('profile', 'full')}  "
                     f"tree {report['tree'][:12]}  commit {report.get('commit')}")
        focus = report.get("focus")
        if focus is not None:
            lines.append(f"  focus: {len(focus['t'])} t/, {len(focus['roast'])} roast file(s)")
        for stage, res in report["stages"].items():
            extra = ""
            if res.get("known_env"):
                extra += f"  known-env: {len(res['known_env'])}"
            if res.get("seconds") is not None:
                extra += f"  {res['seconds']}s"
            lines.append(f"  {stage:<11} {res['status']}{extra}")
            for item in res.get("unexpected", []):
                lines.append(f"      unexpected: {item}")
    return "\n".join(lines)


def elapsed(meta: dict) -> str:
    secs = int(time.time() - meta.get("started_epoch", time.time()))
    return f"running {secs // 60}m{secs % 60:02d}s"


def cmd_wait(root: str, args) -> int:
    deadline = time.time() + args.max
    while True:
        st = job_state(root, args.id)
        if st["state"] == "missing":
            print(f"dev wait: no such job: {args.id}", file=sys.stderr)
            return EXIT_USAGE
        if st["state"] in ("passed", "failed", "lost"):
            print(summarize(root, args.id))
            if st["state"] == "lost":
                print("  the job died without reporting (container restart, OOM kill?); "
                      "start it again", file=sys.stderr)
                return EXIT_LOST
            return EXIT_PASSED if st["state"] == "passed" else EXIT_FAILED
        if time.time() >= deadline:
            print(summarize(root, args.id))
            print(f"dev wait: still running after {args.max}s; wait again", file=sys.stderr)
            return EXIT_RUNNING
        time.sleep(min(2.0, max(0.0, deadline - time.time())))


def cmd_status(root: str, args) -> int:
    ids = [args.id] if args.id else list_jobs(root)
    if not ids:
        print("no jobs")
    for job_id in ids:
        print(summarize(root, job_id))
    return 0


def cmd_report(root: str, args) -> int:
    report = read_json(os.path.join(job_path(root, args.id), "report.json"))
    if report is None:
        print(f"dev report: {args.id} has no report (not a gate, or not started)",
              file=sys.stderr)
        return EXIT_USAGE
    print(json.dumps(report, indent=2))
    return 0


def cmd_log(root: str, args) -> int:
    try:
        with open(os.path.join(job_path(root, args.id), "log"), encoding="utf-8",
                  errors="replace") as fh:
            lines = fh.readlines()
    except FileNotFoundError:
        print(f"dev log: no log for {args.id}", file=sys.stderr)
        return EXIT_USAGE
    sys.stdout.writelines(lines[-args.tail:] if args.tail else lines)
    return 0


def cmd_stop(root: str, args) -> int:
    st = job_state(root, args.id)
    if st["state"] != "running":
        print(f"dev stop: {args.id} is {st['state']}, not running", file=sys.stderr)
        return EXIT_USAGE
    pgid = st["meta"].get("pgid")
    if not pgid:
        print(f"dev stop: {args.id} has not recorded its process group yet", file=sys.stderr)
        return EXIT_USAGE
    os.killpg(pgid, signal.SIGTERM)
    print(f"sent SIGTERM to job {args.id} (process group {pgid})")
    return 0


# --- self-test --------------------------------------------------------------------

SAMPLE_SUMMARY = """\
Test Summary Report
-------------------
roast/S02-literals/listquote.t                         (Wstat: 0 Tests: 24 Failed: 0)
  TODO passed:   2
roast/S16-filehandles/filetest.t                       (Wstat: 8704 (exited 34) Tests: 128 Failed: 34)
  Failed tests:  57-64, 69-72, 77-80, 101-112, 117-118, 121-122
                125-126
  Non-zero exit status: 34
roast/S16-io/eof.t                                     (Wstat: 65280 (exited 255) Tests: 1 Failed: 0)
  Non-zero exit status: 255
  Parse errors: Bad plan.  You planned 5 tests but ran 1.
roast/S99-new/broken.t                                 (Wstat: 256 (exited 1) Tests: 12 Failed: 1)
  Failed test:  10
  Non-zero exit status: 1
Files=1437, Tests=219631, 282 wallclock secs
Result: FAIL
"""

SAMPLE_KNOWN = [
    {"file": "roast/S16-filehandles/filetest.t", "when": "uid0",
     "shape": {"failed": "57-64, 69-72, 77-80, 101-112, 117-118, 121-122, 125-126", "exit": 34}},
    {"file": "roast/S16-io/eof.t", "when": ["uid0", "restricted-proc"],
     "shape": {"exit": 255, "planned": 5, "ran": 1}},
]


def self_test(root: str) -> int:
    failures = []

    def check(name, cond):
        if not cond:
            failures.append(name)

    parsed = parse_prove_summary(SAMPLE_SUMMARY)
    check("summary: TODO-passed file is not a failure",
          [f["file"] for f in parsed] == ["roast/S16-filehandles/filetest.t",
                                          "roast/S16-io/eof.t", "roast/S99-new/broken.t"])
    check("summary: continuation line of Failed tests is read", len(parsed[0]["failed"]) == 34)
    check("summary: exit status", parsed[0]["exit"] == 34 and parsed[1]["exit"] == 255)
    check("summary: bad plan", parsed[1]["planned"] == 5 and parsed[1]["ran"] == 1)
    check("summary: singular 'Failed test:'", parsed[2]["failed"] == [10])
    check("file count", parse_prove_file_count(SAMPLE_SUMMARY) == 1437)

    conds = {"uid0", "restricted-proc"}
    result = judge_stage("roast", 1, SAMPLE_SUMMARY, SAMPLE_KNOWN, conds)
    check("judge: known env failures classified",
          result["known_env"] == ["roast/S16-filehandles/filetest.t", "roast/S16-io/eof.t"])
    check("judge: new failure is unexpected",
          result["unexpected"] == ["roast/S99-new/broken.t: failed 10, exit 1"]
          and result["status"] == "fail")
    result = judge_stage("roast", 1, SAMPLE_SUMMARY, SAMPLE_KNOWN, set())
    check("judge: condition not met -> unexpected", len(result["unexpected"]) == 3)
    changed = SAMPLE_SUMMARY.replace("125-126", "125-127").replace("Failed: 34", "Failed: 35")
    result = judge_stage("roast", 1, changed, SAMPLE_KNOWN, conds)
    check("judge: known file failing in a new shape is unexpected",
          any(u.startswith("roast/S16-filehandles/filetest.t") for u in result["unexpected"]))
    result = judge_stage("test", 2, "error: could not compile\n", SAMPLE_KNOWN, conds)
    check("judge: suite died before prove", result["status"] == "fail"
          and "without a TAP failure summary" in result["unexpected"][0])
    overflow = ("thread 'big_test' (123) has overflowed its stack\n"
                "error: test failed, to rerun pass `--test budget`\n")
    result = judge_stage("test", 2, overflow, SAMPLE_KNOWN, conds)
    check("judge: aborted cargo test binary is named",
          result["unexpected"] == ["cargo test --test budget: big_test overflowed its stack"])
    result = judge_stage("test", 2, "test a::b ... FAILED\nerror: test failed, to rerun pass "
                         "`--lib`\n", SAMPLE_KNOWN, conds)
    check("judge: failed cargo test is named", result["unexpected"] == ["cargo test: a::b"])
    result = judge_stage("test", 0, "All tests successful.\nFiles=3, Tests=9\nResult: PASS\n",
                         SAMPLE_KNOWN, conds)
    check("judge: clean pass", result["status"] == "pass" and result.get("files") == 3)
    result = judge_stage("checks", 2, "check-t-layout: t/foo.t is at t/ top level\n",
                         SAMPLE_KNOWN, conds)
    check("judge: a failing static guard fails its stage", result == {"status": "fail"})
    check("gate: the branch check, then the static guards, run first and block",
          GATE_STAGES[:2] == ("branch", "checks")
          and {"branch", "checks"} <= set(BLOCKING_STAGES))
    check("quick gate: the branch check and static guards run first and block, clippy blocks",
          QUICK_STAGES[:2] == ("branch", "checks") and "clippy" in BLOCKING_STAGES)
    check("quick gate: every stage has a command",
          all(s in STAGE_COMMANDS or s in ("t-focus", "roast-focus") for s in QUICK_STAGES))
    check("gate: formatting is applied up front, not a stage that can fail on a check",
          "fmt" not in GATE_STAGES + QUICK_STAGES + BLOCKING_STAGES
          and "fmt" not in STAGE_COMMANDS
          and FORMAT_COMMAND == ["cargo", "fmt", "--all"])
    cmds = focus_commands(["t/a/x.t"], [])
    check("quick gate: focus runs prove on the debug binary",
          "MUTSU_BIN=target/debug/mutsu" in cmds["t-focus"] and cmds["t-focus"][-1] == "t/a/x.t")
    check("quick gate: an empty focus is a passing no-op", cmds["roast-focus"] == ["true"])
    check("quick gate: a built-in method change widens the focus",
          wide_focus(["src/builtins/method_table/scalars/render.rs"]) == list(WIDE_FOCUS_DIRS)
          and wide_focus(["src/builtins/methods_0arg/mod.rs"]) == list(WIDE_FOCUS_DIRS)
          and wide_focus(["src/builtins/native_method_row_table.rs"]) == list(WIDE_FOCUS_DIRS))
    check("quick gate: another change keeps the focus narrow",
          wide_focus(["src/parser/mod.rs", "t/oo/x.t", "docs/adr/0126.md"]) == [])
    check("ranges", compress_ranges([1, 2, 3, 5, 7, 8]) == "1-3, 5, 7-8")

    real_known = load_known_failures(root)
    check("ci/known-env-failures.toml parses and lists files",
          real_known and all("file" in e and "shape" in e for e in real_known))

    if shutil.which("cargo") and subprocess.run(["cargo", "fmt", "--version"],
                                                capture_output=True).returncode == 0:
        check("format_tree: reformats, names the changed files, then leaves a clean tree alone",
              format_tree_self_test())

    # Job lifecycle, in a throwaway git repository so no real job is disturbed.
    # The commands' own progress output is not part of the verdict.
    with tempfile.TemporaryDirectory() as tmp, contextlib.redirect_stdout(io.StringIO()), \
            contextlib.redirect_stderr(io.StringIO()):
        subprocess.run(["git", "init", "-q", tmp], check=True)
        with open(os.path.join(tmp, ".gitignore"), "w") as fh:
            fh.write("/tmp/\n")
        t0 = tree_id(tmp)
        with open(os.path.join(tmp, "f"), "w") as fh:
            fh.write("x")
        t1 = tree_id(tmp)
        check("tree id changes with an untracked file", t0 != t1)
        os.makedirs(os.path.join(tmp, "tmp", "jobs"))
        check("tree id ignores tmp/", tree_id(tmp) == t1)

        quick = start_job(tmp, "quick", {"kind": "command", "argv": ["sh", "-c", "echo hi"],
                                         "tree": t1})
        rc = cmd_wait(tmp, argparse.Namespace(id=quick, max=30))
        check("job: passes and reports", rc == EXIT_PASSED and job_state(tmp, quick)["exit"] == 0)
        with open(os.path.join(job_path(tmp, quick), "log")) as fh:
            check("job: output captured", "hi" in fh.read())

        bad = start_job(tmp, "bad", {"kind": "command", "argv": ["sh", "-c", "exit 3"],
                                     "tree": t1})
        check("job: failure exit", cmd_wait(tmp, argparse.Namespace(id=bad, max=30)) == EXIT_FAILED
              and job_state(tmp, bad)["exit"] == 3)

        slow = start_job(tmp, "slow", {"kind": "command", "argv": ["sleep", "30"], "tree": t1})
        check("job: bounded wait returns 'running'",
              cmd_wait(tmp, argparse.Namespace(id=slow, max=2)) == EXIT_RUNNING)
        try:
            start_job(tmp, "slow", {"kind": "command", "argv": ["true"], "tree": t1})
            check("lock: a second job of the same name is refused", False)
        except SystemExit:
            pass
        cmd_stop(tmp, argparse.Namespace(id=slow))
        rc = cmd_wait(tmp, argparse.Namespace(id=slow, max=30))
        check("job: stop reports exit 143", rc == EXIT_FAILED
              and job_state(tmp, slow)["exit"] == 143)
        after = start_job(tmp, "slow", {"kind": "command", "argv": ["true"], "tree": t1})
        check("lock: released when the job ends",
              cmd_wait(tmp, argparse.Namespace(id=after, max=30)) == EXIT_PASSED)

        # A job whose supervisor died without writing `exit` is lost.
        lost = new_job_id("lost")
        os.makedirs(job_path(tmp, lost))
        dead = subprocess.Popen(["true"])
        dead.wait()
        write_atomic(os.path.join(job_path(tmp, lost), "meta.json"), json.dumps(
            {"id": lost, "name": "lost", "pid": dead.pid, "pid_start": "0",
             "started_epoch": time.time() - 60}))
        check("job: dead supervisor is lost", job_state(tmp, lost)["state"] == "lost")
        check("wait: lost job", cmd_wait(tmp, argparse.Namespace(id=lost, max=5)) == EXIT_LOST)

    check("branch check: a stale tree on a newer main is caught, own changes are not",
          stale_tree_self_test())

    if failures:
        for f in failures:
            print(f"dev self-test: FAIL: {f}", file=sys.stderr)
        return 1
    print("dev self-test: ok")
    return 0


def format_tree_self_test() -> bool:
    """`format_tree` on a throwaway crate (rustfmt needs no build): an unformatted
    file is rewritten and named, a second pass changes nothing, an untouched
    dirty file is not reported, and a file that does not parse raises."""
    with tempfile.TemporaryDirectory() as proj:
        subprocess.run(["git", "init", "-q", proj], check=True)
        os.makedirs(os.path.join(proj, "src"))
        paths = {name: os.path.join(proj, name) for name in ("Cargo.toml", "src/lib.rs", "notes")}
        for name, text in (("Cargo.toml", '[package]\nname = "fmtprobe"\nversion = "0.0.0"\n'
                                          'edition = "2021"\n'),
                           ("src/lib.rs", "pub fn  f( )->i32{1}\n"), ("notes", "a\n")):
            with open(paths[name], "w", encoding="utf-8") as fh:
                fh.write(text)
        _, changed = format_tree(proj)
        with open(paths["src/lib.rs"], encoding="utf-8") as fh:
            formatted_source = fh.read()
        ok = changed == ["src/lib.rs"] and formatted_source == "pub fn f() -> i32 {\n    1\n}\n"
        with open(paths["notes"], "w", encoding="utf-8") as fh:
            fh.write("b\n")
        ok = ok and format_tree(proj)[1] == []
        with open(paths["src/lib.rs"], "w", encoding="utf-8") as fh:
            fh.write("pub fn (\n")
        try:
            format_tree(proj)
            return False
        except RuntimeError:
            return ok


# --- branch check ---------------------------------------------------------------

# How far back along main's first-parent history a changed file is compared.
BRANCH_CHECK_DEPTH = 200


def blob_states(root: str, commit: str, paths: list[str]) -> dict:
    """The blob id of each of `paths` at `commit` (absent paths are missing)."""
    out = git_lines(root, "ls-tree", "-r", commit, "--", *paths) or []
    states = {}
    for line in out:
        meta, path = line.split("\t", 1)
        states[path] = meta.split()[2]
    return states


def worktree_state(root: str, path: str) -> str | None:
    full = os.path.join(root, path)
    if not os.path.isfile(full):
        return None
    out = git_lines(root, "hash-object", "--", path)
    return out[0] if out else None


def stale_files(root: str, base: str, paths: list[str]) -> list[tuple[str, str]]:
    """The changed `paths` whose working-tree content is an OLDER main version
    of the file (or a deletion of a file main added recently) rather than the
    merge base's: the shape a branch takes when its old tree is committed on
    top of a newer main (`git reset --soft origin/main` after a fetch), which
    silently reverts everything main merged in between."""
    history = git_lines(root, "rev-list", "--first-parent", "-n", str(BRANCH_CHECK_DEPTH), base) or []
    at_base = blob_states(root, base, paths)
    current = {p: worktree_state(root, p) for p in paths}
    found = {}
    for commit in history[1:]:
        older = blob_states(root, commit, paths)
        for path in paths:
            if path in found or current[path] == at_base.get(path):
                continue
            if current[path] == older.get(path):
                found[path] = commit
    return sorted(found.items())


def declared_deletion(root: str, path: str, messages: list[str]) -> bool:
    """Whether the branch deletes `path` on purpose: it is gone from the working
    tree and one of the branch's commit messages carries a `Deletes: <path>`
    trailer. Retiring a file main added recently is otherwise indistinguishable
    from the stale-tree shape (a deletion of a file main added recently)."""
    return (worktree_state(root, path) is None
            and any(line.strip() == f"Deletes: {path}" for line in messages))


def stale_tree_self_test() -> bool:
    """main gains `other` after the branch point; a branch whose own tree is
    then committed on top of that main must have `other` flagged, its own
    file not."""
    import tempfile
    with tempfile.TemporaryDirectory() as repo:
        def git(*argv):
            subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@t", *argv],
                           cwd=repo, check=True, capture_output=True)

        def write(name, text):
            with open(os.path.join(repo, name), "w", encoding="utf-8") as fh:
                fh.write(text)

        git("init", "-q", "-b", "main")
        write("own", "1\n")
        write("other", "1\n")
        git("add", ".")
        git("commit", "-q", "-m", "base")
        git("branch", "topic")
        write("other", "2\n")
        git("commit", "-q", "-am", "main moves on")
        newer_main = git_lines(repo, "rev-parse", "HEAD")[0]
        git("checkout", "-q", "topic")
        write("own", "2\n")
        git("commit", "-q", "-am", "own change")
        clean = stale_files(repo, newer_main, ["own"])
        os.remove(os.path.join(repo, "other"))
        declared = (declared_deletion(repo, "other", ["Deletes: other"])
                    and not declared_deletion(repo, "other", ["Deletes: own"]))
        git("checkout", "-q", "--", "other")
        git("reset", "-q", "--soft", newer_main)
        git("commit", "-q", "-m", "squash onto the newer main")
        paths = git_lines(repo, "diff", "--name-only", newer_main) or []
        stale = [path for path, _ in stale_files(repo, newer_main, paths)]
        return clean == [] and stale == ["other"] and "own" in paths and declared


def cmd_branch_check(root: str, _args) -> int:
    """List the files this branch changes against its merge base with
    origin/main, and fail when one of them is back at an older main state."""
    try:
        subprocess.run(["git", "fetch", "--quiet", "origin", "main"], cwd=root,
                       capture_output=True, timeout=60)
    except subprocess.TimeoutExpired:
        pass
    lines = git_lines(root, "merge-base", "HEAD", "origin/main")
    if not lines:
        print("branch-check: no merge base with origin/main; skipped")
        return 0
    base = lines[0]
    paths = git_lines(root, "diff", "--name-only", base) or []
    paths += git_lines(root, "ls-files", "--others", "--exclude-standard") or []
    paths = sorted(set(paths))
    print(f"branch-check: {len(paths)} file(s) differ from merge base {base[:12]}:")
    for path in paths:
        print(f"  {path}")
    messages = git_lines(root, "log", "--format=%B", f"{base}..HEAD") or []
    if any(line.startswith("This reverts commit") for line in messages):
        print("branch-check: the branch carries a `git revert`; older states are expected")
        return 0
    stale = [(path, commit) for path, commit in stale_files(root, base, paths)
             if not declared_deletion(root, path, messages)]
    for path, commit in stale:
        print(f"branch-check: {path} is back at its state in older main commit {commit[:12]}: "
              f"this branch would revert main's later changes to it")
    if stale:
        print("branch-check: the branch's tree was probably committed on top of a newer main "
              "(e.g. `git reset --soft origin/main` after a fetch). Rebuild it from its own "
              "commits; see AGENTS.md (Git, PRs and CI).")
        return 1
    return 0


# --- main ---------------------------------------------------------------------------

def job_name(text: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9._-]+", text):
        raise argparse.ArgumentTypeError("a job name is [A-Za-z0-9._-]+")
    return text


def main(argv: list[str]) -> int:
    root = repo_root()
    if len(argv) >= 2 and argv[0] == "_supervise":
        supervise(root, argv[1])
        return 0
    ap = argparse.ArgumentParser(prog="scripts/dev", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("run", help="start a detached job")
    p.add_argument("name", type=job_name)
    p.add_argument("command", nargs=argparse.REMAINDER)
    p = sub.add_parser("gate", help="run the pre-publication gate as one job")
    p.add_argument("--only", help=f"comma-separated subset of {','.join(GATE_STAGES)}")
    p.add_argument("--fresh", action="store_true", help="run even if this tree has a result")
    mode = p.add_mutually_exclusive_group()
    mode.add_argument("--quick", action="store_true",
                      help="debug-build profile (the default in a remote container)")
    mode.add_argument("--full", action="store_true", help="the full gate, even remotely")
    p.add_argument("--focus", nargs="+", metavar="PATH",
                   help="quick profile: also run these t/ or roast files or directories")
    p = sub.add_parser("wait", help="block until the job ends, at most --max seconds")
    p.add_argument("id")
    p.add_argument("--max", type=int, default=DEFAULT_WAIT_MAX)
    p = sub.add_parser("status", help="state of one job, or of all")
    p.add_argument("id", nargs="?")
    p = sub.add_parser("report", help="a gate job's report.json")
    p.add_argument("id")
    p = sub.add_parser("log", help="a job's output")
    p.add_argument("id")
    p.add_argument("--tail", type=int, default=0)
    p = sub.add_parser("stop", help="SIGTERM a running job's process group")
    p.add_argument("id")
    sub.add_parser("branch-check",
                   help="list files changed vs the merge base; fail on a stale-tree revert")
    sub.add_parser("self-test", help="exercise the runner")
    args = ap.parse_args(argv)
    return {"run": cmd_run, "gate": cmd_gate, "wait": cmd_wait, "status": cmd_status,
            "report": cmd_report, "log": cmd_log, "stop": cmd_stop,
            "branch-check": cmd_branch_check,
            "self-test": lambda r, _a: self_test(r)}[args.cmd](root, args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
