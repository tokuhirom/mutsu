# Regenerates src/rakuast/hierarchy.tsv from the reference rakudo:
#
#   raku scripts/rakuast-hierarchy.raku > src/rakuast/hierarchy.tsv
#
# One line per name in the `RakuAST::` package tree: the name, its kind
# (`class`, `role` or `package`), its `.^mro` and its `.^roles` (both
# space-separated, `Any`/`Mu` and the name itself left out of the MRO). mutsu
# answers `.^mro`, `.^roles` and smartmatch of the RakuAST type objects and
# nodes from this table (src/rakuast/hierarchy.rs), so the hierarchy is
# measured, never hand-written.
use nqp;
use MONKEY-SEE-NO-EVAL;

my @names = 'RakuAST';
sub walk(Mu $pkg, $prefix) {
    my $who := $pkg.WHO;
    my @keys = (try $who.keys.List) // (try nqp::hllize($who).keys) // ();
    for @keys.sort -> $k {
        next if $k.starts-with('&') || $k.starts-with('$');
        my $name = "$prefix\::$k";
        @names.push: $name;
        walk($who{$k}, $name);
    }
}
walk(RakuAST, 'RakuAST');

say "# Generated by scripts/rakuast-hierarchy.raku from rakudo $*RAKU.compiler.version(); do not edit.";
say "# name\tkind\tmro\troles";
for @names.unique.sort -> $n {
    my Mu $t := EVAL $n;
    my $how = $t.HOW.^name;
    my $kind = $how.ends-with('ClassHOW') ?? 'class'
            !! $how.ends-with('RoleHOW') ?? 'role'
            !! 'package';
    my @mro = $kind eq 'class'
        ?? $t.^mro.map(*.^name).grep({ $_ ne $n && $_ ne 'Any' && $_ ne 'Mu' })
        !! ();
    my @roles = $kind eq 'package' ?? () !! $t.^roles.map(*.^name).unique;
    say ($n, $kind, @mro.join(' '), @roles.join(' ')).join("\t");
}
