# Regenerates src/rakuast/ctor_names.tsv from the reference rakudo:
#
#   raku scripts/rakuast-ctor-names.raku > src/rakuast/ctor_names.tsv
#
# One line per RakuAST class whose `new` declares named parameters and does not
# take a slurpy hash: the class name, then the union of the named parameters of
# every `new` candidate, comma-separated. mutsu refuses any other named
# argument to such a constructor (`Unexpected named argument 'x' passed`, as
# rakudo's bind does), so the accepted names are measured, never hand-written.
# Classes whose `new` is `Mu.new` (a slurpy hash) accept anything and have no row.
use nqp;
use MONKEY-SEE-NO-EVAL;

my @names = 'RakuAST';
sub walk(Mu $pkg, $prefix) {
    my $who := $pkg.WHO;
    my @keys = (try $who.keys.List) // (try nqp::hllize($who).keys) // ();
    for @keys.sort -> $k {
        next if $k.starts-with('&') || $k.starts-with('$');
        my $name = "$prefix\::$k";
        @names.push: $name;
        walk($who{$k}, $name);
    }
}
walk(RakuAST, 'RakuAST');

say "# Generated by scripts/rakuast-ctor-names.raku from rakudo $*RAKU.compiler.version(); do not edit.";
say "# class\tnamed parameters of every `new` candidate";
for @names.unique.sort -> $n {
    my Mu $t := EVAL $n;
    next unless $t.HOW.^name.ends-with('ClassHOW');
    my $new = $t.^find_method('new') or next;
    my @candidates = $new.?candidates // ($new,);
    my @named;
    my $slurpy = False;
    for @candidates -> $c {
        for $c.signature.params.grep(*.named) -> $p {
            if $p.slurpy { $slurpy = True; next }
            @named.push: $p.named_names.head;
        }
    }
    next if $slurpy || !@named;
    say ($n, @named.unique.sort.join(',')).join("\t");
}
