#!/usr/bin/env raku
# Prints the production names of Rakudo's Raku grammar, one per line, sorted:
# the union of the regex methods `$*LANG` carries under both frontends, the
# legacy one (`statement_control:sym<use>`) and RakuAST (`statement-control:sym<use>`).
#
# Slang activation (ADR-13220) uses the list to tell a slang actions-role
# method that handles a grammar production — Rakudo calls an action only for a
# production of that name — from a helper method no parse ever calls.
# src/runtime/rakudo_grammar_productions.txt is this script's output;
# regenerate it whenever the `raku` oracle is upgraded:
#
#   raku scripts/gen-rakudo-grammar-productions.raku > src/runtime/rakudo_grammar_productions.txt

# Each frontend is selected per process, so the script re-runs itself once per
# frontend with `--dump`, which prints that frontend's productions.
multi MAIN(Bool :$dump!) {
    my @names = BEGIN $*LANG.^methods(:all).grep({ .^name eq 'NQPRegex' }).map(*.name).List;
    .say for @names.unique;
}

multi MAIN() {
    my SetHash $names .= new;
    for 0, 1 -> $rakuast {
        my $proc = run $*EXECUTABLE, $*PROGRAM, '--dump', :out,
            :env(|%*ENV, RAKUDO_RAKUAST => $rakuast);
        my @lines = $proc.out.lines(:close);
        die "frontend RAKUDO_RAKUAST=$rakuast failed" unless $proc && @lines;
        $names.set(@lines);
    }
    say "# Rakudo grammar production names (legacy + RakuAST frontends), generated by";
    say "# scripts/gen-rakudo-grammar-productions.raku on rakudo {$*RAKU.compiler.version}";
    .say for $names.keys.sort;
}
