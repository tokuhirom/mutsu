#!/usr/bin/env raku
# Prints the public rule/method names of rakudo's main grammar that carry no
# `:sym<>` adverb, one per line, sorted, behind a header naming the rakudo
# version. src/parser/stmt/simple/core_grammar_rules.txt is this script's
# output; regenerate it whenever the `raku` oracle is upgraded:
#
#   raku scripts/gen-core-grammar-rules.raku > src/parser/stmt/simple/core_grammar_rules.txt
#
# A slang's override of one of these names changes the core grammar; any other
# colon-free rule a slang declares is its own helper (ADR-16888). Private
# methods (`!name`) and `:sym<>` productions are left out.

my @names = BEGIN $*LANG.slang_grammar('MAIN').^methods(:all).map(*.name).unique.sort;

say "# Public rule/method names of rakudo {$*RAKU.compiler.version}'s main grammar without a :sym<> adverb,";
say "# generated by scripts/gen-core-grammar-rules.raku; do not edit. One per line, sorted.";
say "# A slang's override of one of these changes the core grammar; any other";
say "# colon-free rule it declares is its own helper (ADR-16888).";
.say for @names.grep({ !.starts-with('!') && !.contains(':') });
