#!/usr/bin/env raku
# Prints Rakudo's per-class method tables for every built-in owner the committed
# snapshot (src/builtins/rakudo_method_tables.txt) lists, plus the owners named
# on the command line.
#
# Two lists per owner, tab-separated, one line each:
#
#   declared<TAB>Owner<TAB>name<TAB>name...   keys of ::(Owner).^method_table
#                                             (what `.^can` walks per MRO level)
#   methods<TAB>Owner<TAB>name<TAB>name...    names of ::(Owner).^methods
#                                             (what `.^methods` reports)
#   only<TAB>Owner<TAB>name<TAB>name...       the `declared` names whose method
#                                             is an `only` method, not a multi
#                                             dispatcher (what an `augment`
#                                             may not redeclare, #10234)
#   declared.e / methods.e / only.e           the names each list gains under
#                                             language revision 6.e, or all of
#                                             them for an owner only 6.e has
#                                             (`Format`) (Rakudo's
#                                             `core.e` setting: `Any.snip`,
#                                             `Str.nomark`), for the owners
#                                             whose 6.e lists only add names
#                                             (ADR-11276 §9.146)
#
# The 6.e lists come from scripts/rakudo-method-tables-e.raku, run as a child
# process: a `use v6.e.PREVIEW` must be a compilation unit's first statement,
# and an EVAL cannot raise the language revision.
#
# The snapshot is the run-time source of these facts: `.^can`, `.^methods`,
# `.^lookup` and the `augment` conflict read it, gated by the method rows
# (src/builtins/method_introspection.rs, ADR-14032). Owners
# that are not classes in Rakudo (roles such as Blob, RakuAST model nodes that
# mutsu models separately) are skipped. Regenerate with
#
#   raku scripts/gen-rakudo-method-tables.raku [Owner...] > tmp/tables.txt
#   mv tmp/tables.txt src/builtins/rakudo_method_tables.txt
#
# (through a temporary file: the script reads the snapshot it replaces)
# whenever the method rows gain an owner or the vendored Rakudo moves.

# The owners: those the committed snapshot already lists, and any named on the
# command line (a class mutsu has gained rows for).
my $snapshot = $*PROGRAM.parent.parent.add('src/builtins/rakudo_method_tables.txt');
my @listed = $snapshot.e
    ?? $snapshot.lines.grep(!*.starts-with('#')).map({ .split("\t")[1] }).grep(*.defined)
    !! ();
my @owners = (|@listed, |@*ARGS).grep(!*.starts-with('RakuAST::')).unique.sort;

sub clean(@names) { @names.grep({ .defined && $_ ne '' && !/\s/ }).unique.sort }

my %d;
say "# Rakudo method tables, generated by scripts/gen-rakudo-method-tables.raku on rakudo {$*RAKU.compiler.version}";
for @owners -> $owner {
    # Not `try ::($owner)`: `try` turns its value into `Nil` when it is a
    # `Failure`, and `Failure` itself is one of the owners. A name the
    # revision does not know is a defined `Failure` instance.
    my $type := ::($owner);
    if $type.DEFINITE && $type ~~ Failure { $type.so; next }
    # The `Metamodel::*HOW` classes are NQP classes: their own HOW is an
    # `NQPClassHOW`, which has no `.defined`, so they are taken as they are.
    unless $owner.starts-with('Metamodel::') {
        next without $type.HOW;
        next unless $type.HOW ~~ Metamodel::ClassHOW | Metamodel::EnumHOW;
    }
    my @declared = try { clean($type.^method_table.keys) } // next;
    my @methods = try { clean($type.^methods.map(*.name)) } // next;
    my @only = try {
        clean($type.^method_table.pairs.grep({ !.value.?is_dispatcher }).map(*.key))
    } // next;
    say join "\t", 'declared', $owner, |@declared;
    say join "\t", 'methods', $owner, |@methods;
    say join "\t", 'only', $owner, |@only;
    %d{$owner} = { declared => @declared, methods => @methods, only => @only };
}

# The names 6.e adds, for the owners 6.e names the same class and whose lists it
# only extends (under 6.e `::('Exception')` does not resolve to the class).
my $helper = $*PROGRAM.parent.add('rakudo-method-tables-e.raku');
my %e;
for run($*EXECUTABLE, $helper, |@*ARGS, :out).out.lines -> $line {
    my ($kind, $owner, *@names) = $line.split("\t");
    %e{$owner}{$kind} = @names;
}
for %d.keys.sort -> $owner {
    my %lists = %e{$owner} // next;
    next unless all(<declared methods only>.map({ %lists{$_}.defined }));
    next unless all(<declared methods only>.map({ %d{$owner}{$_} (<=) %lists{$_} }));
    my %added = <declared methods only>.map({ $_ => (%lists{$_} (-) %d{$owner}{$_}).keys.sort });
    next unless %added.values.map(*.elems).sum;
    say join "\t", "$_.e", $owner, |%added{$_} for <declared methods only>;
}
# An owner only 6.e declares (`Format`, `Formatter`): every name is a 6.e one.
for %e.keys.sort -> $owner {
    next if %d{$owner}:exists;
    my %lists = %e{$owner};
    next unless all(<declared methods only>.map({ %lists{$_}.defined }));
    say join "\t", "$_.e", $owner, |%lists{$_} for <declared methods only>;
}
