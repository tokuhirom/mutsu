#!/usr/bin/env raku
# Prints the candidates of every multi method in Rakudo's per-class method
# tables for the built-in owners the committed method-table snapshot lists
# (src/builtins/rakudo_method_tables.txt): one tab-separated line per
# (owner, method) naming each candidate's parameters, in declaration order.
#
#   Owner<TAB>name<TAB>candidate<TAB>candidate...
#
# A candidate is its parameters separated by spaces; a parameter is
#
#   flags|Type|smiley|name
#
# `flags` is any of `i` invocant, `n` named, `s` slurpy, `c` capture, `?`
# optional; `Type` is the declared type, empty when the parameter has none;
# `smiley` is `D`, `U` or `-`; `name` is the parameter's name with its sigil.
#
# The snapshot lets the method dispatcher rank a user candidate (an `augment`
# of a built-in type) against the built-in ones, as Rakudo ranks them in one
# dispatcher (src/runtime/builtin_candidates.rs, #12751). Regenerate with
#
#   raku scripts/gen-rakudo-method-candidates.raku > tmp/candidates.txt
#   mv tmp/candidates.txt src/builtins/rakudo_method_candidates.txt
#
# whenever the method-table snapshot or the vendored Rakudo moves.

my $snapshot = $*PROGRAM.parent.parent.add('src/builtins/rakudo_method_tables.txt');
my @owners = $snapshot.lines.grep(!*.starts-with('#')).map({ .split("\t")[1] })
    .grep(*.defined).grep(!*.starts-with('RakuAST::')).unique.sort;

sub describe($p) {
    my $flags = ($p.invocant ?? 'i' !! '') ~ ($p.named ?? 'n' !! '') ~ ($p.slurpy ?? 's' !! '')
        ~ ($p.capture ?? 'c' !! '') ~ ($p.optional ?? '?' !! '');
    my $gist = $p.gist;
    my $type = '';
    my $smiley = '-';
    if $gist ~~ /^ \w/ {
        $type = $p.type.^name;
        if $gist ~~ /^ \S+? ':' (<[DU]>) <?before \s | $> / { $smiley = ~$0 }
    }
    join '|', $flags || '-', $type, $smiley, ($p.name // '');
}

say "# Rakudo multi method candidates, generated by scripts/gen-rakudo-method-candidates.raku on rakudo {$*RAKU.compiler.version}";
for @owners -> $owner {
    my $type := try ::($owner);
    next if $type ~~ Failure && $type.DEFINITE;
    next unless $type.HOW ~~ Metamodel::ClassHOW | Metamodel::EnumHOW;
    my %table = try { $type.^method_table } // next;
    for %table.sort(*.key) -> $pair {
        my $method = $pair.value;
        next unless $method.?is_dispatcher;
        my @candidates = try { $method.candidates } // next;
        next unless @candidates;
        say join "\t", $owner, $pair.key,
            |@candidates.map({ .signature.params.map(&describe).join(' ') });
    }
}
