use Test;

# The RakuAST type hierarchy is rakudo's, measured (src/rakuast/hierarchy.tsv,
# generated by scripts/rakuast-hierarchy.raku from rakudo 2026.09): every
# class's `.^mro`, every class's and role's `.^roles`, and the smartmatch,
# `.isa`, `.does` and `.HOW` answers that follow from them. A walker that
# dispatches on `RakuAST::Term`, `RakuAST::Literal` or a role sees the same
# nodes as on rakudo. This file passes under both mutsu and raku.

plan 28;

sub mro(Mu $t) { $t.^mro.map(*.^name).join(' ') }

is mro(RakuAST::IntLiteral),
    'RakuAST::IntLiteral RakuAST::Literal RakuAST::Term RakuAST::Termish RakuAST::Expression RakuAST::Node Any Mu',
    'a literal inherits from Literal and Termish';
is mro(RakuAST::Call::Method),
    'RakuAST::Call::Method RakuAST::Call::Methodish RakuAST::Postfixish RakuAST::Node Any Mu',
    'Call::Method is not a subclass of its namespace';
is mro(RakuAST::Class),
    'RakuAST::Class RakuAST::Package::Attachable RakuAST::Package RakuAST::Term RakuAST::Termish RakuAST::Expression RakuAST::Node Any Mu',
    'a class declaration is a term';
is mro(RakuAST::Name::Part), 'RakuAST::Name::Part Any Mu', 'a name part is not a Node';
is mro(RakuAST::Code), 'RakuAST::Code', 'a role\'s MRO is the role alone';
is RakuAST::IntLiteral.^parents.map(*.^name).join(' '),
    'RakuAST::Literal RakuAST::Term RakuAST::Termish RakuAST::Expression RakuAST::Node',
    '.^parents';

is RakuAST::IntLiteral.^roles.map(*.^name).join(' '),
    'RakuAST::CompileTimeValue RakuAST::Contextualizable RakuAST::CaptureSource RakuAST::MayCreateBlock RakuAST::CheckTime RakuAST::Sinkable',
    '.^roles of a class';
is RakuAST::Code.^roles.map(*.^name).join(' '), 'RakuAST::ParseTime', '.^roles of a role';
is RakuAST::Code.HOW.^name, 'Perl6::Metamodel::ParametricRoleHOW', 'a role\'s metaclass';
is RakuAST::IntLiteral.HOW.^name, 'Perl6::Metamodel::ClassHOW', 'a class\'s metaclass';

my $lit = RakuAST::IntLiteral.new(42);
ok $lit ~~ RakuAST::Literal, 'a literal node smartmatches Literal';
ok $lit ~~ RakuAST::Termish, '... and Termish';
ok $lit ~~ RakuAST::Sinkable, '... and a role it does';
ok $lit.does(RakuAST::CompileTimeValue), '.does a role';
nok $lit.isa(RakuAST::Sinkable), '.isa excludes roles';
ok $lit.isa(RakuAST::Literal), '.isa an ancestor class';

ok RakuAST::Sub ~~ RakuAST::Code, 'a type object smartmatches a role';
ok RakuAST::Call::Method ~~ RakuAST::Call, 'Call::Method does the Call role';
nok RakuAST::StatementList ~~ RakuAST::Statement, 'StatementList is no Statement';
ok RakuAST::Class.new(name => RakuAST::Name.from-identifier('A')) ~~ RakuAST::Term,
    'a class node is a Term';
is RakuAST::Sub.^isa(RakuAST::Term), 1, '.^isa an ancestor';
is RakuAST::Sub.^isa(RakuAST::Code), 0, '.^isa excludes roles';

is RakuAST.^name, 'RakuAST', 'the RakuAST namespace is a term';
is ::('RakuAST::IntLiteral').^name, 'RakuAST::IntLiteral', 'an indirect lookup';

# Multi dispatch ranks candidates by the same hierarchy: the narrowest
# RakuAST type wins, and a role a node does is narrower than Mu.
class W {
    multi method f(RakuAST::Node:D $) { 'node' }
    multi method f(RakuAST::Literal:D $) { 'literal' }
    multi method f(RakuAST::IntLiteral:D $) { 'int' }
    multi method f(Mu:D $) { 'mu' }
}
class WR {
    multi method f(RakuAST::Sinkable:D $) { 'sinkable' }
    multi method f(Mu:D $) { 'mu' }
}
is W.f(RakuAST::IntLiteral.new(1)), 'int', 'the exact class wins';
is W.f(RakuAST::StrLiteral.new('a')), 'literal', 'an ancestor class beats Node';
is WR.f(RakuAST::Block.new), 'sinkable', 'a role a node does beats Mu';
is W.f(42), 'mu', 'a non-node takes the Mu candidate';
